{
  "name": "nazifoski-app",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nazifoski \"node --test tests/rules.spec.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-nazifoski \"node tests/e2e.spec.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.29.1"
  }
}
